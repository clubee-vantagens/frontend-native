{
  "expo": {
    "name": "Clubee Vantagens",
    "slug": "Clubee Vantagens",
    "version": "1.0.0",
    "orientation": "portrait",
    "icon": "./src/assets/images/novoLogo.png",
    "scheme": "myapp",
    "userInterfaceStyle": "automatic",
    "newArchEnabled": true,
    "splash": {
      "image": "./src/assets/images/novoLogo.png",
      "resizeMode": "contain",
      "backgroundColor": "#FFEAAD"
    },
    "ios": {
      "supportsTablet": true
    },
    "android": {
      "adaptiveIcon": {
        "foregroundImage": "./src/assets/images/novoLogo.png",
        "backgroundColor": "#FFEAAD"
      }
    },
    "web": {
      "bundler": "metro",
      "output": "static",
      "favicon": "./src/assets/images/novoLogo.png"
    },
    "assetBundlePatterns": [
      "src/assets/**/*"
    ],
    "plugins": [
      "expo-router",
      "expo-font",
      "expo-secure-store"
    ],
    "experiments": {
      "typedRoutes": true
    }
    
  }
}
